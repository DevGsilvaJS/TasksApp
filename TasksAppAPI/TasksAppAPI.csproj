<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <!-- Copia a pasta Planilha (raiz do repo) para o output/publish para o Render encontrar em produção -->
  <Target Name="CopyPlanilhaToOutput" AfterTargets="Build">
    <PropertyGroup>
      <PlanilhaSource Condition="Exists('$(MSBuildProjectDirectory)\..\Planilha')">$(MSBuildProjectDirectory)\..\Planilha</PlanilhaSource>
    </PropertyGroup>
    <ItemGroup Condition="'$(PlanilhaSource)' != ''">
      <PlanilhaFiles Include="$(PlanilhaSource)\**\*.*" />
    </ItemGroup>
    <Copy Condition="'$(PlanilhaSource)' != ''" SourceFiles="@(PlanilhaFiles)" DestinationFolder="$(OutputPath)\Planilha\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyPlanilhaToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <PlanilhaSource Condition="Exists('$(MSBuildProjectDirectory)\..\Planilha')">$(MSBuildProjectDirectory)\..\Planilha</PlanilhaSource>
    </PropertyGroup>
    <ItemGroup Condition="'$(PlanilhaSource)' != ''">
      <PlanilhaFiles Include="$(PlanilhaSource)\**\*.*" />
    </ItemGroup>
    <Copy Condition="'$(PlanilhaSource)' != ''" SourceFiles="@(PlanilhaFiles)" DestinationFolder="$(PublishDir)\Planilha\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
